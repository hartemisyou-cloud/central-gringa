# Server-only. Enter real values through the deployment's secret settings.
DATABASE_URL=
ADMIN_PANEL_PASSWORD=
ADMIN_SESSION_SECRET=
PAYMENTS_ENCRYPTION_KEY=

# Server-only e-book delivery, after a signed payment confirmation.
# DELIVERY_EMAIL_FROM must be a sender on a verified Resend domain.
RESEND_API_KEY=
DELIVERY_EMAIL_FROM=

# Private Vercel Blob: connected deployments prefer the rotating OIDC identity.
BLOB_STORE_ID=
# Local migration only, if a separately approved read-write token is used.
BLOB_READ_WRITE_TOKEN=

# Local database migration only; never expose through VITE_* or public variables.
MIGRATION_DATABASE_URL=
CENTRAL_RUNTIME_PASSWORD=
